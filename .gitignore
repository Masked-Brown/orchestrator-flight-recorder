# ---------------------------------------------------------------------------
# The raw conversation export: NEVER committed.
#
# This repo is public. The export is the most sensitive file involved — every
# conversation, in full. Only windowed, human-swept excerpts ever ship, and they
# ship inside runs/.
#
# Before any commit: run `git status` and confirm none of these appear.
# ---------------------------------------------------------------------------

# the export archive, however it arrives
*.zip
data-*/

# the unzipped export files
conversations.json
users.json
projects.json
projects/
memories*.json
login_history.json

# anything parse.py writes locally: manifests hold raw conversation text
out/

# scratch space from earlier work
ofr-scout/

# ---------------------------------------------------------------------------
# Ordinary Python noise
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
